{
  "name": "viral-pet-nix",
  "version": "2.4.1",
  "private": true,
  "description": "Nix — Timeline Dodge. Skill-based viral pet game.",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/.bin/jest --forceExit",
    "test:ci": "node --experimental-vm-modules node_modules/.bin/jest --forceExit --ci --reporters=default",
    "test:e2e": "npx playwright test",
    "test:e2e:headed": "npx playwright test --headed",
    "lint:static": "node test/static-checks.js",
    "gauntlet": "npm run lint:static && npm run test:ci && npm run test:e2e && echo 'ALL GATES PASSED'"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "serve": "^14.2.6"
  }
}
